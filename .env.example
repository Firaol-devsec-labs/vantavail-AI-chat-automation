# .env.example – copy to .env and fill in your secrets

# ─────────────────────────────────────────────
# Telegram MTProto credentials (obtain from https://my.telegram.org)
# ─────────────────────────────────────────────
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_SESSION_NAME=Vantavail_session

# Owner username (Telegram handle without @)
OWNER_USERNAME=YOUR_TELEGRAM_USERNAME

# ─────────────────────────────────────────────
# AI Provider Settings (choose one)
# ─────────────────────────────────────────────
# Options: gemini | deepseek
AI_PROVIDER=gemini

# Google Gemini configuration (if using gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/

# DeepSeek / OpenRouter configuration (if using deepseek)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=openrouter/free
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# System prompt (can be overridden at runtime)
AI_SYSTEM_PROMPT="You are Vantavail, [Your name e.g John]'s chat automation assistant. Always introduce yourself as 'Vantavail' and ask the user what they need."

# ─────────────────────────────────────────────
# Security Settings
# ─────────────────────────────────────────────
SECURITY_ENABLED=True
MAX_MESSAGES_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
AUTO_BLOCK_THRESHOLD=5
BLOCK_DURATION_MINUTES=60
SCAN_SUSPICIOUS_CONTENT=True

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DB_PATH=data/vantavail.db

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=ERROR
